# Nom affiché de l'application (configurable).
VITE_APP_NAME=Pocket

# Synchronisation Supabase — facultative. Laisser vide pour le mode 100 % local.
# URL du projet : Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=
# Clé publique « anon » (ou « publishable »). Elle est conçue pour être exposée au navigateur :
# la sécurité repose sur les politiques RLS. NE JAMAIS mettre ici la clé service_role / secret.
VITE_SUPABASE_ANON_KEY=
